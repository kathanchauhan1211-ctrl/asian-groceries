# ─── Firebase Admin SDK (Server-side only) ───────────────────────────────────
# Set these in your hosting platform's environment settings (NOT committed to git)

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id

# ─── Firebase Client SDK (Browser-safe, NEXT_PUBLIC_ prefix) ─────────────────
# These are safe to expose — they're public API keys
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Resend (Transactional Email) ────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
ADMIN_EMAIL=admin@yourdomain.com
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# ─── DPD Interconnector API (Server-side only — NEVER expose to browser) ─────
# Obtain from your DPD Lithuania sales representative / account portal
# Production:  https://integracijos.dpd.lt
# Test/sandbox: https://lt.integration.dpd.eo.pl
DPD_API_USERNAME=your_dpd_username
DPD_API_KEY=your_dpd_api_key
DPD_API_URL=https://integracijos.dpd.lt
