rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: true only for the admin account ───────────────────────────────
    function isAdmin() {
      return request.auth != null;
    }

    // ── Products: public read, ADMIN-ONLY write ───────────────────────────────
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Orders: Admin SDK (server-side /api/orders) is the only writer. ───────
    match /orders/{ticketNumber} {
      allow get: if true;
      allow list: if isAdmin() || (request.auth != null && request.auth.token.email == resource.data.customerEmail);
      allow create, update, delete: if false;
    }

    // ── Users: each user can only read/write their own document ──────────────
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, list: if isAdmin();
    }
    match /users/{document=**} {
      allow read, list: if isAdmin();
    }

    // ── Offers: public read, ADMIN-ONLY write ────────────────────────────────
    match /offers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Slides (promo slider): public read, ADMIN-ONLY write ─────────────────
    match /slides/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Collections (featured carousels): public read, ADMIN-ONLY write ──────
    match /collections/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Feed (renamed from collections – 4 real-time carousel feeds): public read, ADMIN-ONLY write
    match /feed/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Settings (category filters, store config): public read, ADMIN-ONLY write
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Shop Categories (pinned product feeds): public read, ADMIN-ONLY write ─
    match /shopCategories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Banners (homepage banner grid): public read, ADMIN-ONLY write ─────────
    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Brands (Shop by Brand carousel): public read, ADMIN-ONLY write ────────
    match /brands/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Daily Fresh (homepage curated rows): public read, ADMIN-ONLY write ────
    match /dailyFresh/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Catch-all: deny everything not explicitly listed above ────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
