rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: true only for the admin account ───────────────────────────────
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == 'indianmarket@test.com';
    }

    // ── Products: public read, ADMIN-ONLY write ───────────────────────────────
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Orders: Admin SDK (server-side /api/orders) is the only writer. ───────
    // ── Client-side direct writes are blocked (allow create: if false).  ───────
    // ── Tracking: order doc ID is the unguessable ticketNumber.          ───────
    // ── allow get but deny list prevents enumerating all orders.         ───────
    match /orders/{ticketNumber} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    // ── Users: each user can only read/write their own document ──────────────
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin();
    }

    // ── Offers: public read, ADMIN-ONLY write ────────────────────────────────
    match /offers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Slides (promo slider): public read, ADMIN-ONLY write ─────────────────
    match /slides/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Collections (featured carousels): public read, ADMIN-ONLY write ──────
    match /collections/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Settings: public read, ADMIN-ONLY write ───────────────────────────────
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Catch-all: deny everything not explicitly listed above ────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
